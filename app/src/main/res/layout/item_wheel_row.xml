<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingVertical="4dp">

    <!-- Ruota Name Badge -->
    <TextView
        android:id="@+id/tvRuotaName"
        android:layout_width="82dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_wheel_badge"
        android:gravity="center"
        android:paddingHorizontal="6dp"
        android:paddingVertical="6dp"
        android:text="BARI"
        android:textColor="@color/text_primary"
        android:textSize="12sp"
        android:textStyle="bold" />

    <!-- 5 Lotto Balls -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvNum1"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginHorizontal="2dp"
            android:background="@drawable/bg_lotto_ball"
            android:gravity="center"
            android:text="12"
            android:textColor="@color/ball_number"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvNum2"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginHorizontal="2dp"
            android:background="@drawable/bg_lotto_ball"
            android:gravity="center"
            android:text="34"
            android:textColor="@color/ball_number"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvNum3"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginHorizontal="2dp"
            android:background="@drawable/bg_lotto_ball"
            android:gravity="center"
            android:text="56"
            android:textColor="@color/ball_number"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvNum4"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginHorizontal="2dp"
            android:background="@drawable/bg_lotto_ball"
            android:gravity="center"
            android:text="78"
            android:textColor="@color/ball_number"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvNum5"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginHorizontal="2dp"
            android:background="@drawable/bg_lotto_ball"
            android:gravity="center"
            android:text="90"
            android:textColor="@color/ball_number"
            android:textSize="14sp"
            android:textStyle="bold" />

    </LinearLayout>

</LinearLayout>